# Copy this file to community-c.env and replace every placeholder.
# Never commit community-c.env or pass secrets as Docker build arguments.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__DefaultConnection=Host=db.example.com;Port=5432;Database=community_c;Username=community_c;Password=replace-me;SSL Mode=Require;Trust Server Certificate=true

JwtSettings__Key=replace-with-a-long-random-signing-key
JwtSettings__Issuer=Community_C
JwtSettings__Audience=Community_C
JwtSettings__AccessTokenExpiryMinutes=30
JwtSettings__RefreshExpiryDays=7

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning

OAuth__Naver__Id=replace-me
OAuth__Naver__Secret=replace-me
OAuth__Naver__Redirect_URL=https://example.com/SocialLogin/OAuthNaverLogin
OAuth__Kakao__Id=replace-me
OAuth__Kakao__Secret=replace-me
OAuth__Kakao__Redirect_URL=https://example.com/SocialLogin/OAuthKakaoLogin
OAuth__Google__Id=replace-me
OAuth__Google__Secret=replace-me
OAuth__Google__Redirect_URL=https://example.com/SocialLogin/OAuthGoogleLogin

AllowedHosts=example.com
