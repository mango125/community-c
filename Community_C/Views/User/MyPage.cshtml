@model User

@{
    ViewData["Title"] = "마이페이지";

    var displayName = string.IsNullOrWhiteSpace(Model.name) ? "사용자" : Model.name;
    var profileInitial = displayName[..1];
    var statusText = Model.status == "active" ? "활성 계정" : Model.status;
    var canWriteBoard = Community_C.Utility.Security.BoardPermissions.CanWrite(Model.permission);
    var permissionText = canWriteBoard ? "게시판 작성 가능" : "게시판 읽기 전용";
    var permissionDescription = canWriteBoard
        ? "게시글 작성·수정, 댓글과 추천 기능을 사용할 수 있습니다."
        : "게시글과 댓글을 조회할 수 있으며 작성 기능은 제한됩니다.";
}

<section aria-labelledby="myPageTitle">
    <header class="page-header">
        <div>
            <h1 class="page-title" id="myPageTitle">마이페이지</h1>
            <p class="page-description">계정 정보와 커뮤니티에서 사용할 닉네임을 관리합니다.</p>
        </div>
    </header>

    <div class="profile-layout">
        <aside class="surface-card profile-summary">
            <div class="profile-avatar" aria-hidden="true">@profileInitial</div>
            <h2 class="profile-name">@displayName</h2>
            <p class="profile-email">@Model.email</p>
            <span class="profile-status">@statusText</span>
        </aside>

        <section class="surface-card profile-edit-card" aria-labelledby="profileEditTitle">
            <h2 class="h5 mb-1" id="profileEditTitle">내 정보</h2>
            <p class="page-description mb-4">가입 정보 확인과 닉네임 수정이 가능합니다.</p>

            <div class="profile-info-grid">
                <div class="profile-info">
                    <span class="profile-info-label">이메일</span>
                    <span class="profile-info-value">@Model.email</span>
                </div>
                <div class="profile-info">
                    <span class="profile-info-label">가입일</span>
                    <time class="profile-info-value"
                          datetime="@Model.createDate.ToString("O")">@Model.createDate.ToString("yyyy-MM-dd")</time>
                </div>
                <div class="profile-info profile-permission">
                    <span class="profile-info-label">게시판 권한</span>
                    <span class="profile-info-value">@permissionText</span>
                    <span class="profile-info-description">@permissionDescription</span>
                </div>
            </div>

            <form asp-controller="User"
                  asp-action="UpdateUser"
                  class="authorize-form"
                  method="post">
                <div class="mb-4">
                    <label asp-for="name" class="form-label">커뮤니티 닉네임</label>
                    <input asp-for="name"
                           class="form-control"
                           maxlength="20"
                           required />
                    <div class="form-text">게시글과 댓글에 표시되는 이름입니다.</div>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">변경 내용 저장</button>
                </div>
            </form>
        </section>
    </div>
</section>
