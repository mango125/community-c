@model User

@{
    ViewData["Title"] = "회원가입";
}

<section class="signup-page" aria-labelledby="signUpTitle">
    <div class="signup-form mx-auto">
        <h1 class="h4 mb-3" id="signUpTitle">회원가입</h1>

        <form asp-controller="User"
              asp-action="SignUpInsert"
              method="post"
              id="registrationForm"
              novalidate>
            <div class="mb-3">
                <label asp-for="name" class="form-label">닉네임 (최대 20자)</label>
                <input asp-for="name"
                       class="form-control"
                       maxlength="20"
                       required />
                <div class="invalid-feedback">닉네임을 입력해주세요.</div>
            </div>

            <div class="row">
                <div class="col-md-9 mb-3">
                    <label asp-for="email" class="form-label">이메일</label>
                    <input asp-for="email"
                           type="email"
                           class="form-control"
                           maxlength="20"
                           autocomplete="username"
                           required />
                    <div class="invalid-feedback">이메일을 입력해주세요.</div>
                </div>
                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <button type="button"
                            class="btn btn-secondary w-100"
                            id="duplicateCheckButton">중복 확인</button>
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">비밀번호</label>
                <input type="password"
                       class="form-control"
                       id="password"
                       name="password"
                       autocomplete="new-password"
                       required />
                <div class="invalid-feedback">비밀번호를 입력해주세요.</div>
            </div>

            <button class="btn btn-primary btn-lg" type="submit">가입 완료</button>
        </form>
    </div>
</section>

@section Styles {
    <style>
        .signup-page {
            min-height: calc(100vh - 10rem);
            padding: 80px 1rem 2rem;
            background: linear-gradient(to top right, #f2f2f2 0%, #d3d3d3 100%);
        }

        .signup-form {
            max-width: 680px;
            padding: 32px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }
    </style>
}

@section Scripts {
    <script>
        const registrationForm = document.getElementById('registrationForm');
        const emailInput = document.getElementById('email');
        const duplicateCheckButton = document.getElementById('duplicateCheckButton');
        let checkedEmail = null;

        const resetDuplicateCheck = () => {
            checkedEmail = null;
            duplicateCheckButton.classList.remove('btn-primary');
            duplicateCheckButton.classList.add('btn-secondary');
        };

        emailInput.addEventListener('input', resetDuplicateCheck);

        duplicateCheckButton.addEventListener('click', async () => {
            const email = emailInput.value.trim();

            if (!email || !emailInput.checkValidity()) {
                alert('올바른 이메일을 입력해주세요.');
                emailInput.focus();
                return;
            }

            try {
                const response = await fetch('@Url.Action("CheckUserDuplicate", "User")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(email)
                });

                if (!response.ok) {
                    throw new Error('중복 확인 요청에 실패했습니다.');
                }

                const result = await response.json();

                if (result.isDuplicate) {
                    resetDuplicateCheck();
                    alert('중복된 아이디입니다.');
                    return;
                }

                checkedEmail = email;
                duplicateCheckButton.classList.remove('btn-secondary');
                duplicateCheckButton.classList.add('btn-primary');
                alert('사용 가능한 아이디입니다.');
            } catch (error) {
                resetDuplicateCheck();
                console.error('중복 확인 오류:', error);
                alert('아이디를 확인해주세요.');
            }
        });

        registrationForm.addEventListener('submit', (event) => {
            if (!registrationForm.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
                registrationForm.classList.add('was-validated');
                return;
            }

            if (checkedEmail !== emailInput.value.trim()) {
                event.preventDefault();
                alert('아이디 중복을 확인해주세요.');
            }
        });
    </script>
}
